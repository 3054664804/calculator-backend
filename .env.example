# 后端环境变量示例：复制为 .env 后按需修改（生产环境在平台后台配置）

# SQLite 数据库文件路径（默认 ./data/calculator.db）
CALC_DB_PATH=./data/calculator.db

# 允许跨域访问的前端来源：多个用英文逗号分隔；* 表示不限制（仅建议开发环境使用）
# 生产示例：CALC_CORS_ORIGINS=https://calculator-frontend-eight.vercel.app
CALC_CORS_ORIGINS=*

# 服务名称与日志级别
CALC_APP_NAME=计算器后端 API
CALC_LOG_LEVEL=INFO

# 本地调试时是否开启热重载（1 开启 / 0 关闭）
CALC_RELOAD=0
